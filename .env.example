# Окружение приложения
APP_ENV=production
LOG_LEVEL=INFO
LOG_USER_CONTENT=false
LOG_CONTENT_MAX_LENGTH=500
APP_TIMEZONE=Europe/Minsk
PUBLIC_BASE_URL=https://bot.example.com
API_BIND_HOST=127.0.0.1
API_PORT=8000
UVICORN_WORKERS=2
CELERY_CONCURRENCY=4

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_VISION_TIMEOUT_SECONDS=180
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_MATCH_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODEL=gpt-4o-transcribe

# PostgreSQL
POSTGRES_DB=bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+psycopg://bot:replace_with_a_strong_password@postgres:5432/bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
ORDER_EVENT_RETENTION_DAYS=365
TELEGRAM_UPDATE_RETENTION_DAYS=30

# Redis и Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_MAXMEMORY=256mb

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_VENUE_DIRECTORY_URL=https://docs.google.com/spreadsheets/d/replace_me/gviz/tq?tqx=out:json&gid=replace_me
GOOGLE_REGISTRATION_SPREADSHEET_ID=replace_me
GOOGLE_REGISTRATION_SHEET=Чаты
GOOGLE_CATALOG_SHEET=Заявка
GOOGLE_HISTORY_SHEET=История товары(API)
GOOGLE_PRODUCT_ADD_SHEET=Добавить
GOOGLE_RECALC_URL=https://script.google.com/macros/s/replace_me/exec
GOOGLE_RECALC_TOKEN=replace_me
GOOGLE_RECALC_SHEET=Заявка
VENUE_DIRECTORY_CACHE_TTL_SECONDS=120
CATALOG_CACHE_TTL_SECONDS=60
DEFAULT_DEPARTMENT=Кухня

# Наблюдаемость
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://langfuse.example.com
LANGFUSE_TRACING_ENVIRONMENT=production
